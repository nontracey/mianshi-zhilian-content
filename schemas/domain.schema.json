{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content.mianshi-zhilian.com/schemas/domain.schema.json",
  "type": "object",
  "required": ["id", "title", "description", "categories"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "icon": { "type": "string" },
    "themeColor": { "type": "string" },
    "accentColor": { "type": "string" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "order", "topics"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "order": { "type": "integer" },
          "topics": {
            "type": "array",
            "items": { "type": "string", "pattern": "^topics/[a-z0-9-]+/.+\\.json$" }
          }
        }
      }
    }
  }
}
