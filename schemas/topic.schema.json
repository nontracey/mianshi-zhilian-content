{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content.mianshi-zhilian.com/schemas/topic.schema.json",
  "type": "object",
  "required": [
    "id",
    "domain",
    "category",
    "title",
    "summary",
    "tags",
    "difficulty",
    "estimatedMinutes",
    "order",
    "recommendWeight",
    "learningCards",
    "recallPrompts",
    "rubric"
  ],
  "additionalProperties": true,
  "$defs": {
    "followUpQuestion": {
      "type": "object",
      "required": ["question", "answer"],
      "additionalProperties": true,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 }
      }
    },
    "codeHighlight": {
      "type": "object",
      "required": ["line", "note"],
      "additionalProperties": true,
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "cardSource": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "enum": ["svg", "mermaid", "text"] },
        "path": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["path"] },
        { "required": ["content"] }
      ],
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "svg" } }, "required": ["kind", "path"] },
          "then": {
            "properties": {
              "path": { "pattern": "^assets/" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "svg" } }, "required": ["kind", "content"] },
          "then": {
            "properties": {
              "content": { "pattern": "^\\s*<svg(?:\\s|>)" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["mermaid", "text"] } },
            "required": ["kind"]
          },
          "then": {
            "required": ["content"],
            "not": { "required": ["path"] }
          }
        }
      ]
    },
    "learningCard": {
      "type": "object",
      "required": ["type", "title"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["explain", "interviewAnswer", "compareTable", "code", "animation", "diagram", "checklist"]
        },
        "title": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" } },
        "language": { "type": "string", "minLength": 1 },
        "highlights": { "type": "array", "items": { "$ref": "#/$defs/codeHighlight" } },
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "followUpQuestions": {
          "type": "array",
          "items": { "$ref": "#/$defs/followUpQuestion" }
        },
        "format": { "type": "string" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cardSource" }
        },
        "svgPath": { "type": "string" },
        "asset": { "type": "string" },
        "svg": { "type": "string" },
        "fallback": { "type": "string" },
        "caption": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "code" } }, "required": ["type"] },
          "then": { "required": ["language"] }
        },
        {
          "if": { "properties": { "type": { "const": "compareTable" } }, "required": ["type"] },
          "then": {
            "anyOf": [
              { "required": ["content"] },
              { "required": ["columns", "rows"] }
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "interviewAnswer" } }, "required": ["type"] },
          "then": {
            "properties": {
              "followUpQuestions": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "diagram" },
              "format": { "const": "mermaid" }
            },
            "required": ["type", "format"]
          },
          "then": {
            "required": ["content"],
            "properties": {
              "content": { "pattern": "^\\s*(?:```mermaid\\s*)?(?:(?:flowchart|graph)\\s+(?:TB|TD|BT|LR|RL)|stateDiagram(?:-v2)?|sequenceDiagram)\\b" }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
    "domain": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "group": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "order": { "type": "integer" },
    "recommendWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
    "learningCards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/learningCard" }
    },
    "recallPrompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "mode"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["text", "code", "voice"] },
          "expectedMinutes": { "type": "integer", "minimum": 1 },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "status": { "type": "string", "enum": ["production", "staging", "draft"] },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "interviewFrequency": { "type": "string", "enum": ["high", "medium", "low"] },
    "interviewerFocus": { "type": "string" },
    "rubric": {
      "type": "object",
      "required": ["mustHave", "goodToHave", "commonMistakes", "scoreWeights"],
      "additionalProperties": true,
      "properties": {
        "mustHave": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "goodToHave": { "type": "array", "items": { "type": "string" } },
        "commonMistakes": { "type": "array", "items": { "type": "string" } },
        "scoreWeights": {
          "type": "object",
          "required": ["coverage", "accuracy", "interviewExpression", "depth"],
          "additionalProperties": true,
          "properties": {
            "coverage": { "type": "integer", "minimum": 0, "maximum": 100 },
            "accuracy": { "type": "integer", "minimum": 0, "maximum": 100 },
            "interviewExpression": { "type": "integer", "minimum": 0, "maximum": 100 },
            "depth": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      }
    }
  }
}
