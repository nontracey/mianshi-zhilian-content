{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content.mianshi-zhilian.com/schemas/topic.schema.json",
  "type": "object",
  "required": [
    "id",
    "domain",
    "category",
    "title",
    "summary",
    "tags",
    "difficulty",
    "estimatedMinutes",
    "order",
    "recommendWeight",
    "learningCards",
    "recallPrompts",
    "rubric"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
    "domain": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "group": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "order": { "type": "integer" },
    "recommendWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
    "learningCards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "title"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["explain", "interviewAnswer", "compareTable", "code", "animation", "diagram", "checklist"]
          },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "recallPrompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "mode"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["text", "code", "voice"] },
          "expectedMinutes": { "type": "integer", "minimum": 1 },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "rubric": {
      "type": "object",
      "required": ["mustHave", "goodToHave", "commonMistakes", "scoreWeights"],
      "additionalProperties": true,
      "properties": {
        "mustHave": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "goodToHave": { "type": "array", "items": { "type": "string" } },
        "commonMistakes": { "type": "array", "items": { "type": "string" } },
        "scoreWeights": {
          "type": "object",
          "required": ["coverage", "accuracy", "interviewExpression", "depth"],
          "properties": {
            "coverage": { "type": "integer" },
            "accuracy": { "type": "integer" },
            "interviewExpression": { "type": "integer" },
            "depth": { "type": "integer" }
          }
        }
      }
    }
  }
}
