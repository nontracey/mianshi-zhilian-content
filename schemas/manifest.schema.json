{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content.mianshi-zhilian.com/schemas/manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "contentVersion", "minAppVersion", "defaultDomain", "domains"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "contentVersion": { "type": "string" },
    "minAppVersion": { "type": "string" },
    "defaultDomain": { "type": "string" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "entry", "topicCount", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "entry": { "type": "string" },
          "topicCount": { "type": "integer" },
          "updatedAt": { "type": "string" }
        }
      }
    }
  }
}
