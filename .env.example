# ===== 面试智练内容仓库 LLM 配置模板（v3 / API only）=====
# 用法：
#   ① 复制为 .env：cp .env.example .env
#   ② 一键从 ~/.qwen/settings.json 的 env 段种入真实 key（不会覆盖已填值）：
#        node scripts/llm/seed-env.mjs
#   ③ 跑：npm run quality:refine:interactive 一路回车即可（所有默认值都在这里）
# 模型清单在 scripts/llm/env-config.mjs 里硬编码（13 个 OpenAI 兼容端点）。
# spec 格式：<provider>:<modelId>，例如 volcengine:glm-5.1。

# ===== Secrets =====
HUOSHAN_API_KEY=
DEEPSEEK_API_KEY=
BAIDU_API_KEY=
LONGCHAT_API_KEY=
MIMO_API_KEY=
OPENCODE_API_KEY=
# 其它 OpenAI 兼容端点（当前未在模型清单里使用）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ===== 精修场景（默认 火山 glm-5.1，便宜、reasoning low、改写稳）=====
REFINE_TEMPERATURE=0.3
REFINE_TOP_P=0.9
REFINE_MAX_TOKENS=16384
REFINE_TIMEOUT_MS=120000
REFINE_RETRY=3
REFINE_MODEL_CHAIN=volcengine:glm-5.1,volcengine:deepseek-v4-flash

# ===== 整篇评审场景（默认 火山 deepseek-v4-pro，分稳）=====
JUDGE_TEMPERATURE=0.1
JUDGE_TOP_P=0.9
JUDGE_MAX_TOKENS=8192
JUDGE_TIMEOUT_MS=120000
JUDGE_RETRY=3
JUDGE_MODEL_CHAIN=volcengine:deepseek-v4-pro,volcengine:deepseek-v4-flash

# ===== 块级评审（默认 火山 glm-5.1，调用频次高、便宜优先）=====
BLOCK_JUDGE_TEMPERATURE=0.1
BLOCK_JUDGE_TOP_P=0.9
BLOCK_JUDGE_MAX_TOKENS=4096
BLOCK_JUDGE_TIMEOUT_MS=60000
BLOCK_JUDGE_RETRY=2
BLOCK_JUDGE_MODEL_CHAIN=volcengine:glm-5.1,volcengine:deepseek-v4-flash

# ===== 模型链通用 =====
# 连续 N 次可用性失败后降级到下一个 spec（10min 滑动窗口）
LLM_DEGRADE_AFTER=3

# ===== 流式与日志 =====
# 默认 SSE 流式（部分 provider 失败会自动回退非流式）
LLM_STREAM=true
# 留空只渲染 TUI；填路径则同时写 JSONL 事件流（未来 web shell 用）
LLM_LIVE_EVENTS=
# 子 agent 行展示的最新一行截断长度
SUBAGENT_LAST_LINE_MAX=80

# ===== 额度耗尽行为 =====
# manual = 全局暂停，等用户手动回车继续；auto-probe = 自动按退避周期探活；skip = 当前篇标记 quota-skip 跳下一篇
QUOTA_PAUSE_DEFAULT=manual
# 自动探活退避节奏（毫秒，逗号分隔；超出最后一个就一直用最后一个）
QUOTA_PROBE_BACKOFF_MS=60000,120000,300000,600000
# 探活只发极少 token，避免再耗额度
QUOTA_PROBE_MAX_TOKENS=4

# ===== 内容卡片降级链 / Mermaid 解禁（app 渲染器已支持 stateDiagram/sequenceDiagram/subgraph/5色classDef）=====
REFINE_ALLOW_COMPLEX_MERMAID=true

# ===== 交互向导默认值（填满后一路回车直达确认）=====
# scope: failing | all | domain:<id> | topic:<id>
DEFAULT_SCOPE=failing
DEFAULT_LIMIT=20
DEFAULT_MAX_ROUNDS=3
DEFAULT_CONCURRENCY=4
DEFAULT_MIN_SCORE=95
DEFAULT_USE_JUDGE=true
DEFAULT_JUDGE_COUNT=1
DEFAULT_TEST_RUN=false
