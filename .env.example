# ===== 面试智练内容仓库 LLM 配置模板（v3 / API only）=====
# 用法：
#   ① 复制为 .env：cp .env.example .env
#   ② 一键从 ~/.qwen/settings.json 的 env 段种入真实 key（不会覆盖已填值）：
#        node scripts/llm/seed-env.mjs
#   ③ 跑：npm run quality:refine:interactive 一路回车即可（所有默认值都在这里）
# 模型清单在 scripts/llm/env-config.mjs 里声明；默认走免费/限额在线模型。
# spec 格式：<provider>:<modelId>，例如 zhipu:glm-4.7-flash。

# ===== Secrets =====
ZHIPU_API_KEY=
LONGCAT_API_KEY=
AGNES_API_KEY=

# ===== 自定义模型池（免费模型 / 多账号 / 本地模型 / 1M 上下文）=====
# 日常优先用分组变量，不需要手写 JSON。spec 仍是 <provider>:<id>[@accountId]。
# 1) 先列别名；2) 每个别名用 LLM_MODEL_<别名>_<字段> 配置。
# 别名会自动转成大写下划线：ollama_14b -> LLM_MODEL_OLLAMA_14B_*。
# 通用可选字段（任意模型都能用，不写死在代码里）：
#   *_MAX_CONCURRENCY=100   模型级并发上限（模型池五层限流的 model 层）。
#   *_QPS=100               每秒起始速率上限（模型池令牌桶；不填=不限）。
#   *_EXPIRES_AT=2026-06-30 有效期（YYYY-MM-DD 含当天全天，或 ISO 时间戳）。到期后该模型自动从
#                           可用列表剔除、resolveSpec 抛 availabilityFailure，链上自动降级到下一个模型。
LLM_CUSTOM_MODELS=

# 多模态在线模型（图片理解+文本）+ 有效期 + 并发/QPS 限制示例（讯飞星火 MaaS）：
# 注意 ID 必须用接口 /v2/models 返回的真实 id（如 xopqwen36v35b），不是展示名。
# XF_MAAS_API_KEY=<apikey:apisecret>
# LLM_CUSTOM_MODELS=xf_qwen3
# LLM_MODEL_XF_QWEN3_PROVIDER=xfyun
# LLM_MODEL_XF_QWEN3_ID=xopqwen36v35b
# LLM_MODEL_XF_QWEN3_NAME=Qwen3.6-35B-A3B (xfyun MaaS)
# LLM_MODEL_XF_QWEN3_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
# LLM_MODEL_XF_QWEN3_API_KEY_ENV=XF_MAAS_API_KEY
# LLM_MODEL_XF_QWEN3_TIER=free
# LLM_MODEL_XF_QWEN3_MODALITY=text,json,image
# LLM_MODEL_XF_QWEN3_IMAGE_UNDERSTANDING=native
# LLM_MODEL_XF_QWEN3_MAX_CONCURRENCY=100
# LLM_MODEL_XF_QWEN3_QPS=100
# LLM_MODEL_XF_QWEN3_EXPIRES_AT=2026-06-30
# LLM_MODEL_XF_QWEN3_MAX_CONTEXT=32768
# LLM_MODEL_XF_QWEN3_MAX_OUTPUT_TOKENS=8192

# 本地 Ollama/vLLM 示例：
# LLM_CUSTOM_MODELS=ollama_14b
# LLM_MODEL_OLLAMA_14B_PROVIDER=ollama
# LLM_MODEL_OLLAMA_14B_ID=qwen2.5:14b
# LLM_MODEL_OLLAMA_14B_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL_OLLAMA_14B_TIER=local
# LLM_MODEL_OLLAMA_14B_LOCAL=true
# LLM_MODEL_OLLAMA_14B_API_KEY_OPTIONAL=true
# LLM_MODEL_OLLAMA_14B_MODALITY=text,json
# LLM_MODEL_OLLAMA_14B_MAX_CONTEXT=32768
# LLM_MODEL_OLLAMA_14B_MAX_OUTPUT_TOKENS=8192
# LLM_MODEL_OLLAMA_14B_AUTOSCALE_ENABLED=false
# LLM_MODEL_OLLAMA_14B_AUTOSCALE_MAX=1

# 1M 上下文 / 付费兜底示例：
# LLM_CUSTOM_MODELS=ollama_14b,qwen_long
# LLM_MODEL_QWEN_LONG_PROVIDER=qwen-long
# LLM_MODEL_QWEN_LONG_ID=qwen-plus-1m
# LLM_MODEL_QWEN_LONG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_QWEN_LONG_API_KEY_ENV=DASHSCOPE_API_KEY
# LLM_MODEL_QWEN_LONG_TIER=paid
# LLM_MODEL_QWEN_LONG_MODALITY=text,json
# LLM_MODEL_QWEN_LONG_MAX_CONTEXT=1048576
# LLM_MODEL_QWEN_LONG_MAX_OUTPUT_TOKENS=8192
# LLM_MODEL_QWEN_LONG_IMAGE_UNDERSTANDING=none
# LLM_MODEL_QWEN_LONG_PRICE_INPUT_PER_MTOK=0.4
# LLM_MODEL_QWEN_LONG_PRICE_OUTPUT_PER_MTOK=1.2

# 多账号示例（同一模型不同 key 轮询；spec 可写 free_refine:glm-4.7-flash@a 指定账号）：
# LLM_CUSTOM_MODELS=free_refine
# LLM_MODEL_FREE_REFINE_PROVIDER=free-refine
# LLM_MODEL_FREE_REFINE_ID=glm-4.7-flash
# LLM_MODEL_FREE_REFINE_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL_FREE_REFINE_TIER=free
# LLM_MODEL_FREE_REFINE_ACCOUNTS=a,b
# LLM_MODEL_FREE_REFINE_ACCOUNT_A_API_KEY_ENV=ZHIPU_API_KEY_A
# LLM_MODEL_FREE_REFINE_ACCOUNT_A_WEIGHT=1
# LLM_MODEL_FREE_REFINE_ACCOUNT_B_API_KEY_ENV=ZHIPU_API_KEY_B
# LLM_MODEL_FREE_REFINE_ACCOUNT_B_WEIGHT=1

# 高级兜底：复杂 extraParams / 批量导入时仍可用 JSON 或文件。
LLM_MODELS_JSON=
LLM_MODELS_FILE=

# 本地模型自动发现（Ollama /api/tags + vLLM /v1/models）。默认关闭避免误加。
LLM_AUTODISCOVER_LOCAL=false
LLM_AUTODISCOVER_ENDPOINTS=ollama:http://127.0.0.1:11434,vllm:http://127.0.0.1:8000

# ===== 精修场景（默认 Z.AI GLM-4.7 Flash，免费 200K 上下文）=====
REFINE_TEMPERATURE=0.3
REFINE_TOP_P=0.9
REFINE_MAX_TOKENS=16384
REFINE_TIMEOUT_MS=120000
REFINE_RETRY=3
REFINE_MODEL_CHAIN=zhipu:glm-4.7-flash,longcat:LongCat-2.0-Preview

# ===== 整篇评审场景（默认 LongCat 1M 上下文，日 500w token；GLM 兜底）=====
JUDGE_TEMPERATURE=0.1
JUDGE_TOP_P=0.9
JUDGE_MAX_TOKENS=8192
JUDGE_TIMEOUT_MS=120000
JUDGE_RETRY=3
JUDGE_MODEL_CHAIN=longcat:LongCat-2.0-Preview,zhipu:glm-4.7-flash

# ===== 块级评审（默认 GLM-4.7 Flash，便宜/免费优先）=====
BLOCK_JUDGE_TEMPERATURE=0.1
BLOCK_JUDGE_TOP_P=0.9
BLOCK_JUDGE_MAX_TOKENS=4096
BLOCK_JUDGE_TIMEOUT_MS=60000
BLOCK_JUDGE_RETRY=2
BLOCK_JUDGE_MODEL_CHAIN=zhipu:glm-4.7-flash,longcat:LongCat-2.0-Preview

# ===== 视觉判官（默认走 Agnes MCP；若 Agnes 视觉模型不可用，会显式 not_checked）=====
VISION_JUDGE_ENABLED=true
VISION_JUDGE_TEMPERATURE=0.1
VISION_JUDGE_TOP_P=0.9
VISION_JUDGE_MAX_TOKENS=4096
VISION_JUDGE_TIMEOUT_MS=120000
VISION_JUDGE_RETRY=2
VISION_JUDGE_MODEL_CHAIN=
# MCP 工具引用：单数（向后兼容）或复数（逗号分隔多工具并发跑）。
# 示例：VISION_JUDGE_MCP_TOOLS=agnes:visual_judge,browser:screenshot
VISION_JUDGE_MCP_TOOL=
VISION_JUDGE_MCP_TOOLS=agnes:visual_judge

# ===== 联网事实核验（deep 严格启动默认要求开启）=====
# 优先级链：显式 backend > MCP > auto 内置 > not_checked
# auto：按 google-cse(需 key+cx) → bing(需 key) → baidu(国内零配置首选) → sogou → duckduckgo 顺序探测可用
FACT_CHECK_ENABLED=true
FACT_CHECK_BACKEND=auto
FACT_CHECK_MCP_TOOL=
FACT_CHECK_MCP_TOOLS=
FACT_CHECK_RECENCY_DAYS=1095
FACT_CHECK_API_KEY=                 # Google CSE / Bing 用
FACT_CHECK_CX=                      # Google CSE 专用
FACT_CHECK_NUM_RESULTS=3
FACT_CHECK_FETCH_TIMEOUT_MS=15000
FACT_CHECK_PROBE_CACHE_MS=600000    # 后端可达性探测缓存
FACT_CHECK_CACHE_TTL_MS=3600000     # 搜索结果缓存（同 topic 多轮不重复）
FACT_CHECK_USER_AGENT=              # 留空用默认浏览器 UA

# ===== MCP 服务（可接多个；工具用 server:tool 引用）=====
# 日常优先用分组变量；ARGS 用逗号分隔。复杂 env/args 可用 *_JSON。
# 示例：Agnes MCP 提供 image_generate，并在 AGNES_VISION_MODEL_CHAIN 支持图像输入时提供 visual_judge。
MCP_SERVERS=agnes
MCP_SERVER_AGNES_COMMAND=node
MCP_SERVER_AGNES_ARGS=scripts/mcp/agnes-image-server.mjs
MCP_SERVER_AGNES_TIMEOUT_MS=120000
MCP_SERVERS_JSON=
MCP_SERVERS_FILE=

AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
# 视觉判官是 chat/completions 读图链路；Agnes Image 只负责生图。
# 如果前一个模型不支持 image_url，会继续试下一个，最终显式 not_checked。
AGNES_VISION_MODEL_CHAIN=agnes-1.5-flash,agnes-2.0-flash
AGNES_VISION_MODEL=agnes-1.5-flash
# 本地 Mac 默认用 qlmanage 把 SVG artifact 渲成 PNG 后再给视觉模型读。
AGNES_RENDER_SVG_TO_PNG=true
AGNES_RENDER_SIZE=1024
AGNES_RENDER_TIMEOUT_MS=15000

# ===== 模型链通用 =====
# 连续 N 次可用性失败后降级到下一个 spec（10min 滑动窗口）
LLM_DEGRADE_AFTER=3

# 弱/本地模型输出协议自适应：只影响 API response_format 起步模式，不降低本地 schema/审计/判官验收标准。
# weak 默认 json_object，local 默认 prompt，避免不稳定 strict json_schema 反复 400 或漏字段。
LLM_WEAK_SCHEMA_MODE=json_object
LLM_LOCAL_SCHEMA_MODE=prompt

# ===== 模型池 / 队列限流 =====
# 外层 DEFAULT_CONCURRENCY 控制同时处理多少 topic；这里控制 LLM 资源池。
LLM_POOL_GLOBAL_CONCURRENCY=8
LLM_POOL_KIND_REFINE=4
LLM_POOL_KIND_JUDGE=4
LLM_POOL_KIND_BLOCK_JUDGE=4
LLM_POOL_KIND_VISION_JUDGE=1
LLM_POOL_KIND_DIAGRAM_GENERATE=2
# 可按 provider/account/model 细分，例如：
# LLM_POOL_PROVIDER_ZHIPU=2
# LLM_POOL_PROVIDER_LONGCAT=1
# LLM_POOL_MODEL_OLLAMA_QWEN2_5_14B=1

# 自动伸缩（仅 tier=free 默认开启）：连续 3 次成功且 latency < target → 增并发；连续 2 次 quota/timeout → 减并发
LLM_POOL_AUTOSCALE_ENABLED=true
LLM_POOL_AUTOSCALE_MIN=1
LLM_POOL_AUTOSCALE_MAX=10
LLM_POOL_AUTOSCALE_TARGET_LATENCY_MS=5000
LLM_POOL_AUTOSCALE_ERROR_BACKOFF_MS=30000

# ===== 图候选选优（视觉判官 fail 时触发 N 候选重生 → 选最优落盘）=====
DIAGRAM_CANDIDATE_ENABLED=true
DIAGRAM_CANDIDATE_COUNT=3
DIAGRAM_CANDIDATE_MODEL_CHAIN=zhipu:glm-4.7-flash,longcat:LongCat-2.0-Preview
DIAGRAM_CANDIDATE_ALLOW_PAID=false  # 默认禁用付费模型生成图；--allow-paid-diagram 或交互向导开启
DIAGRAM_CANDIDATE_MAX_RETRIES=2   # 同一张图连续 fail N 次后标 stuck 保留旧版
DIAGRAM_GENERATE_TEMPERATURE=0.4
DIAGRAM_GENERATE_TOP_P=0.9
DIAGRAM_GENERATE_MAX_TOKENS=8192
DIAGRAM_GENERATE_TIMEOUT_MS=120000
DIAGRAM_GENERATE_RETRY=2

# ===== 精修器运行 profile（quick=单轮无联网无图重生 / deep=全开默认 / offline=仅本地静态）=====
# CLI --profile=quick|deep|offline 覆盖此值
QUALITY_REFINE_PROFILE=deep
# 严格启动：deep 默认开启。启动前会按目标 topic 检查判官、事实核验、SVG 视觉判官、图候选能力；
# 能力不够直接退出，避免“跑起来但质量闸缺一块”。
QUALITY_REFINE_STRICT_STARTUP=true

# ===== 成本统计 + token 预算（v3.3）=====
# 留空=不设硬上限；超限优雅停止本轮，summary.json 标 budgetExceeded
# MAX_TOKENS_PER_RUN=
# MAX_COST_PER_RUN=               # USD
# MAX_LOCAL_GPU_SECONDS=

# ===== 流式与日志 =====
# 默认 SSE 流式（部分 provider 失败会自动回退非流式）
LLM_STREAM=true
# 留空只渲染 TUI；填路径则同时写 JSONL 事件流（未来 web shell 用）
LLM_LIVE_EVENTS=
# 子 agent 行展示的最新一行截断长度
SUBAGENT_LAST_LINE_MAX=80

# ===== 额度耗尽行为 =====
# manual = 全局暂停，等用户手动回车继续；auto-probe = 自动按退避周期探活；skip = 当前篇标记 quota-skip 跳下一篇
QUOTA_PAUSE_DEFAULT=manual
# 自动探活退避节奏（毫秒，逗号分隔；超出最后一个就一直用最后一个）
QUOTA_PROBE_BACKOFF_MS=60000,120000,300000,600000
# 探活只发极少 token，避免再耗额度
QUOTA_PROBE_MAX_TOKENS=4

# ===== 内容卡片降级链 / Mermaid 解禁（app 渲染器已支持 stateDiagram/sequenceDiagram/subgraph/5色classDef）=====
REFINE_ALLOW_COMPLEX_MERMAID=true

# ===== 交互向导默认值（填满后一路回车直达确认）=====
# scope: failing | all | domain:<id> | topic:<id>
DEFAULT_SCOPE=failing
DEFAULT_LIMIT=20
DEFAULT_MAX_ROUNDS=3
DEFAULT_CONCURRENCY=4
DEFAULT_MIN_SCORE=95
DEFAULT_USE_JUDGE=true
DEFAULT_JUDGE_COUNT=1
DEFAULT_TEST_RUN=false
