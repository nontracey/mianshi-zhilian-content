#!/bin/sh
set -eu

# 快速确定性门禁(秒级,无 LLM 调用)：只对“你这次要提交的 topic”把关，
# 不对历史存量连坐(仓库里现存 <90 或未清理的篇不会阻断你提交别的文件)。
#   - 每篇暂存 topic：JSON 必须可解析；确定性质量分必须 ≥90。
# 全量 schema/质量校验(npm run validate / quality:audit)仍由 CI 兜底。
# 需要临时跳过：git commit --no-verify。

staged_topics=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^topics/.*\.json$' || true)
if [ -n "$staged_topics" ]; then
  echo "[pre-commit] 质量门禁(暂存 topic：JSON + 确定性分数)..."
  # shellcheck disable=SC2086
  node scripts/quality_gate_staged.mjs $staged_topics
else
  echo "[pre-commit] 无暂存 topic，跳过质量门禁"
fi
