#!/bin/sh
# Check for non-ASCII characters that may cause Cloudflare Pages API to reject
COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Check if message contains non-ASCII characters
HAS_NON_ASCII=$(printf '%s' "$COMMIT_MSG" | LC_ALL=C grep -c '[^[:print:][:space:]]' || true)
if [ "$HAS_NON_ASCII" -gt 0 ]; then
    echo "⚠️  Commit message contains non-ASCII characters."
    echo "   Cloudflare Pages API may reject this. The workflow will auto-sanitize it."
    echo "   Message: $COMMIT_MSG"
    echo ""
    # Don't block the commit, just warn (workflow handles it)
fi
